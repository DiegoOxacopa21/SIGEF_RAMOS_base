{
    "name": "sigef/ramos-t",
    "description": "SIGEF-RAMOS - Sistema Integral de Gestion de Funerarias",
    "type": "project",
    "autoload": {
        "classmap": [
            "controllers/",
            "models/",
            "config/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require-dev": {
        "pestphp/pest": "^2.34",
        "guzzlehttp/guzzle": "^7.8"
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test:unit": "vendor/bin/pest tests/Unit",
        "test:integration": "vendor/bin/pest tests/Integration",
        "test:e2e": "vendor/bin/pest tests/E2E",
        "test:smoke": "vendor/bin/pest tests/Smoke",
        "test:regression": "vendor/bin/pest tests/Regression"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "nunomaduro/collision": true
        }
    }
}
